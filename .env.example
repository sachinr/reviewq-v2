# Copy to .env and fill in. See README.md for how each value is obtained.

# --- Slack app credentials (api.slack.com/apps) ---
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Any random string; used to sign the OAuth state parameter.
SLACK_STATE_SECRET=change-me

# --- Secrets ---
# 32-byte key for encrypting Slack tokens at rest. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- Infrastructure ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reviewed
REDIS_URL=redis://127.0.0.1:6379

# --- AI (Phase 2; optional for now) ---
ANTHROPIC_API_KEY=

# --- Misc ---
NODE_ENV=development
PORT=3000
APP_NAME=Reviewed
